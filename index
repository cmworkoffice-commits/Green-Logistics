<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Green Logistics — Global Sustainable Freight</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,300;0,700;1,300&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --green:   #1a7a4a;
  --green-d: #0e4f2f;
  --teal:    #0d9488;
  --sky:     #0ea5e9;
  --amber:   #f59e0b;
  --indigo:  #6366f1;
  --rose:    #e11d48;
  --lime:    #84cc16;
  --ink:     #0c1a12;
  --muted:   #4b6358;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html{scroll-behavior:smooth;}
body{font-family:'Outfit',sans-serif;background:#f0faf4;color:var(--ink);font-weight:300;overflow-x:hidden;}

/* NAV */
nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;justify-content:space-between;align-items:center;padding:1.1rem 3rem;background:var(--green-d);box-shadow:0 2px 20px rgba(0,0,0,0.2);}
.logo{font-family:'Fraunces',serif;font-weight:700;font-size:1.1rem;color:#fff;text-decoration:none;display:flex;align-items:center;gap:.7rem;}
.logo-dot{width:10px;height:10px;border-radius:50%;background:var(--lime);flex-shrink:0;}
.nav-links{display:flex;gap:2.2rem;list-style:none;}
.nav-links a{font-size:.83rem;font-weight:400;color:rgba(255,255,255,0.65);text-decoration:none;transition:color .2s;}
.nav-links a:hover{color:#fff;}
.nav-cta{font-size:.83rem;font-weight:600;background:var(--lime);color:var(--ink);padding:.55rem 1.5rem;border-radius:100px;text-decoration:none;transition:all .2s;}
.nav-cta:hover{background:#fff;transform:translateY(-1px);}

/* HERO */
.hero{min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:5rem 0 0;background:linear-gradient(145deg,#0a3d22 0%,#1a7a4a 55%,#0d9488 100%);position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse 60% 70% at 70% 40%,rgba(132,204,22,0.12) 0%,transparent 65%);pointer-events:none;}
.hero-text{padding:4rem 3rem 4rem 4rem;position:relative;z-index:1;}
.hero-label{font-size:.72rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--lime);margin-bottom:1.5rem;display:flex;align-items:center;gap:.6rem;}
.hero-label::before{content:'';width:24px;height:1px;background:var(--lime);}
h1{font-family:'Fraunces',serif;font-size:clamp(2.8rem,4.5vw,5rem);font-weight:700;line-height:.97;letter-spacing:-.03em;color:#fff;margin-bottom:1.5rem;}
h1 em{font-style:italic;font-weight:300;color:var(--lime);}
.hero-desc{font-size:.98rem;color:rgba(255,255,255,0.65);line-height:1.75;max-width:440px;margin-bottom:2.5rem;}
.hero-cta{display:inline-flex;align-items:center;gap:.6rem;background:var(--lime);color:var(--ink);padding:.9rem 2rem;border-radius:100px;font-weight:600;font-size:.92rem;text-decoration:none;transition:all .25s;}
.hero-cta:hover{background:#fff;transform:translateY(-2px);box-shadow:0 12px 30px rgba(0,0,0,0.2);}
.hero-img{position:relative;height:100%;min-height:580px;}
.hero-img img{width:100%;height:100%;object-fit:cover;opacity:.5;display:block;}
.hero-img::after{content:'';position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,61,34,0.85) 0%,rgba(10,61,34,0.1) 100%);}
.hero-stats{grid-column:span 2;display:grid;grid-template-columns:repeat(4,1fr);background:rgba(0,0,0,0.28);backdrop-filter:blur(12px);}
.h-stat{padding:1.8rem 2rem;border-right:1px solid rgba(255,255,255,0.08);text-align:center;}
.h-stat:last-child{border-right:none;}
.h-stat-num{font-family:'Fraunces',serif;font-size:2rem;font-weight:700;color:var(--lime);line-height:1;margin-bottom:.3rem;}
.h-stat-lbl{font-size:.7rem;color:rgba(255,255,255,0.45);letter-spacing:.06em;text-transform:uppercase;}

/* ABOUT */
.about-strip{display:grid;grid-template-columns:1fr 1fr;min-height:480px;}
.about-img{position:relative;overflow:hidden;}
.about-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s;}
.about-img:hover img{transform:scale(1.04);}
.about-img::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(14,79,47,0.5),transparent);}
.about-content{background:#fff;padding:5rem 4rem;display:flex;flex-direction:column;justify-content:center;}
.section-tag{font-size:.7rem;font-weight:600;letter-spacing:.2em;text-transform:uppercase;color:var(--green);margin-bottom:.9rem;display:flex;align-items:center;gap:.6rem;}
.section-tag::before{content:'';width:18px;height:2px;background:var(--green);border-radius:2px;}
h2{font-family:'Fraunces',serif;font-size:clamp(1.8rem,2.8vw,2.4rem);font-weight:700;letter-spacing:-.025em;color:var(--ink);}
.about-content h2{margin-bottom:1.2rem;}
.about-content p{font-size:.9rem;color:var(--muted);line-height:1.8;margin-bottom:1rem;}
.about-tags{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1.5rem;}
.tag{font-size:.72rem;font-weight:500;padding:.4rem .9rem;border-radius:100px;}
.tag-green{background:#dcfce7;color:#166534;}
.tag-blue{background:#e0f2fe;color:#0369a1;}
.tag-amber{background:#fef3c7;color:#92400e;}

/* SERVICES */
.services{padding:6rem 3rem;background:#fff;}
.section-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:3rem;gap:2rem;}
.section-note{font-size:.85rem;color:var(--muted);max-width:320px;line-height:1.6;text-align:right;}
.svc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.2rem;}
.svc-card{border-radius:16px;padding:2rem 1.8rem;position:relative;overflow:hidden;transition:transform .25s,box-shadow .25s;cursor:default;}
.svc-card:hover{transform:translateY(-5px);box-shadow:0 20px 50px rgba(0,0,0,0.13);}
.svc-card:nth-child(1){background:linear-gradient(145deg,#0e4f2f,#1a7a4a);}
.svc-card:nth-child(2){background:linear-gradient(145deg,#0369a1,#0ea5e9);}
.svc-card:nth-child(3){background:linear-gradient(145deg,#b45309,#f59e0b);}
.svc-card:nth-child(4){background:linear-gradient(145deg,#5b21b6,#8b5cf6);}
.svc-card:nth-child(5){background:linear-gradient(145deg,#0f766e,#0d9488);}
.svc-card:nth-child(6){background:linear-gradient(145deg,#9f1239,#e11d48);}
.svc-card:nth-child(7){background:linear-gradient(145deg,#92400e,#d97706);grid-column:span 2;}
.svc-icon{font-size:2.2rem;margin-bottom:1.2rem;display:block;}
.svc-name{font-family:'Fraunces',serif;font-size:1.1rem;font-weight:700;color:#fff;margin-bottom:.4rem;}
.svc-tag{font-size:.68rem;font-weight:500;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,0.55);margin-bottom:.9rem;display:block;}
.svc-desc{font-size:.82rem;color:rgba(255,255,255,0.78);line-height:1.65;}

/* GALLERY */
.gallery{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:280px 280px;gap:4px;}
.gallery-item{overflow:hidden;position:relative;}
.gallery-item img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s;}
.gallery-item:hover img{transform:scale(1.06);}
.gallery-item:nth-child(1){grid-row:span 2;}
.gallery-label{position:absolute;bottom:0;left:0;right:0;padding:1.2rem 1.4rem;background:linear-gradient(transparent,rgba(0,0,0,0.65));color:#fff;font-size:.8rem;font-weight:500;}

/* IMPACT */
.impact{padding:6rem 3rem;background:linear-gradient(135deg,#ecfdf5 0%,#f0fdfa 50%,#eff6ff 100%);display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center;}
.impact-left h2{margin-bottom:1.2rem;color:var(--green-d);}
.impact-left p{font-size:.9rem;color:var(--muted);line-height:1.8;margin-bottom:1rem;max-width:420px;}
.impact-right-img{border-radius:16px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.12);}
.impact-right-img img{width:100%;height:340px;object-fit:cover;display:block;}
.impact-nums{display:grid;grid-template-columns:1fr 1fr;gap:1.2rem;margin-top:2.5rem;}
.i-card{background:#fff;border-radius:14px;padding:1.6rem;box-shadow:0 4px 20px rgba(0,0,0,0.06);border-top:4px solid;transition:transform .2s;}
.i-card:hover{transform:translateY(-3px);}
.i-card:nth-child(1){border-color:var(--green);}
.i-card:nth-child(2){border-color:var(--sky);}
.i-card:nth-child(3){border-color:var(--teal);}
.i-card:nth-child(4){border-color:var(--amber);}
.i-num{font-family:'Fraunces',serif;font-size:2.2rem;font-weight:700;line-height:1;margin-bottom:.4rem;}
.i-card:nth-child(1) .i-num{color:var(--green);}
.i-card:nth-child(2) .i-num{color:var(--sky);}
.i-card:nth-child(3) .i-num{color:var(--teal);}
.i-card:nth-child(4) .i-num{color:var(--amber);}
.i-lbl{font-size:.78rem;color:var(--muted);line-height:1.5;}

/* WHY US */
.why{padding:6rem 3rem;background:#fff;}
.why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2rem;margin-top:3rem;}
.why-card{border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.07);transition:transform .25s,box-shadow .25s;}
.why-card:hover{transform:translateY(-5px);box-shadow:0 16px 40px rgba(0,0,0,0.12);}
.why-card-img{height:200px;overflow:hidden;}
.why-card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s;}
.why-card:hover .why-card-img img{transform:scale(1.06);}
.why-card-body{padding:1.6rem;background:#fff;}
.why-icon{font-size:1.5rem;margin-bottom:.8rem;display:block;}
.why-card-body h4{font-family:'Fraunces',serif;font-weight:700;font-size:1.05rem;color:var(--ink);margin-bottom:.5rem;}
.why-card-body p{font-size:.82rem;color:var(--muted);line-height:1.65;}

/* COVERAGE */
.coverage{padding:6rem 3rem;background:var(--green-d);}
.coverage .section-head h2{color:#fff;}
.coverage .section-note{color:rgba(255,255,255,0.45);}
.regions-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:1rem;margin-top:3rem;}
.region{background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:1.8rem 1.4rem;transition:all .25s;}
.region:hover{background:rgba(132,204,22,0.1);border-color:rgba(132,204,22,0.35);transform:translateY(-4px);}
.r-flag{font-size:1.8rem;margin-bottom:.8rem;display:block;}
.r-name{font-family:'Fraunces',serif;font-size:1rem;font-weight:700;color:#fff;margin-bottom:.5rem;}
.r-detail{font-size:.75rem;color:rgba(255,255,255,0.45);line-height:1.7;}

/* PROCESS */
.process{padding:6rem 3rem;background:linear-gradient(135deg,#f0faf4,#e0f2fe);}
.process-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;margin-top:3.5rem;position:relative;}
.process-steps::before{content:'';position:absolute;top:28px;left:12%;right:12%;height:2px;background:linear-gradient(90deg,var(--green),var(--teal),var(--sky));border-radius:2px;}
.p-step{text-align:center;position:relative;padding-top:.5rem;}
.p-num{width:56px;height:56px;border-radius:50%;font-family:'Fraunces',serif;font-weight:700;font-size:1.2rem;display:grid;place-items:center;margin:0 auto 1.4rem;position:relative;z-index:1;transition:all .3s;}
.p-step:nth-child(1) .p-num{background:var(--green);color:#fff;}
.p-step:nth-child(2) .p-num{background:var(--teal);color:#fff;}
.p-step:nth-child(3) .p-num{background:var(--sky);color:#fff;}
.p-step:nth-child(4) .p-num{background:var(--lime);color:var(--ink);}
.p-step:hover .p-num{transform:scale(1.1);box-shadow:0 8px 24px rgba(0,0,0,0.15);}
.p-step h4{font-family:'Fraunces',serif;font-weight:700;font-size:.95rem;color:var(--ink);margin-bottom:.5rem;}
.p-step p{font-size:.8rem;color:var(--muted);line-height:1.65;}

/* TESTIMONIALS */
.testimonials{padding:6rem 3rem;background:#fff;}
.testi-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.5rem;margin-top:3rem;}
.testi{border-radius:16px;padding:2rem;border:1px solid rgba(0,0,0,0.07);transition:all .3s;}
.testi:hover{transform:translateY(-4px);box-shadow:0 16px 40px rgba(0,0,0,0.08);}
.testi:nth-child(1){background:linear-gradient(135deg,#f0fdf4,#dcfce7);border-color:#bbf7d0;}
.testi:nth-child(2){background:linear-gradient(135deg,#f0f9ff,#e0f2fe);border-color:#bae6fd;}
.testi:nth-child(3){background:linear-gradient(135deg,#fdf4ff,#ede9fe);border-color:#ddd6fe;}
.testi-q{font-size:2.5rem;font-family:Georgia,serif;line-height:.8;margin-bottom:1rem;}
.testi:nth-child(1) .testi-q{color:var(--green);}
.testi:nth-child(2) .testi-q{color:var(--sky);}
.testi:nth-child(3) .testi-q{color:var(--indigo);}
.testi p{font-size:.85rem;color:#374151;line-height:1.75;margin-bottom:1.5rem;font-style:italic;}
.testi-person{display:flex;align-items:center;gap:.8rem;}
.testi-av{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;font-family:'Fraunces',serif;font-weight:700;font-size:.9rem;color:#fff;flex-shrink:0;}
.testi:nth-child(1) .testi-av{background:var(--green);}
.testi:nth-child(2) .testi-av{background:var(--sky);}
.testi:nth-child(3) .testi-av{background:var(--indigo);}
.testi-name{font-weight:600;font-size:.85rem;color:var(--ink);}
.testi-role{font-size:.72rem;color:var(--muted);}

/* CONTACT */
.contact{padding:6rem 3rem;display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:start;background:linear-gradient(135deg,#ecfdf5,#fff);}
.contact-left h2{margin-bottom:1rem;}
.contact-left>p{font-size:.9rem;color:var(--muted);line-height:1.75;margin-bottom:2rem;}
.offices{display:flex;flex-direction:column;gap:1rem;}
.office{padding:1.2rem 1.5rem;border-radius:10px;border-left:4px solid;}
.offices .office:nth-child(1){border-color:var(--green);background:#f0faf4;}
.offices .office:nth-child(2){border-color:var(--teal);background:#f0fdfd;}
.office strong{display:block;font-size:.72rem;font-weight:600;color:var(--muted);margin-bottom:.3rem;letter-spacing:.08em;text-transform:uppercase;}
.office span{font-size:.85rem;color:var(--ink);font-weight:400;}
.contact-email{font-family:'Fraunces',serif;font-size:1.05rem;font-weight:700;color:var(--green);text-decoration:none;display:inline-block;margin-top:.2rem;transition:color .2s;}
.contact-email:hover{color:var(--teal);}
.contact-right{display:flex;flex-direction:column;gap:1rem;}
.office-r{padding:1.2rem 1.5rem;border-radius:10px;border-left:4px solid;}
.office-r:nth-child(1){border-color:var(--sky);background:#f0f9ff;}
.office-r:nth-child(2){border-color:var(--indigo);background:#f5f3ff;}
.office-r:nth-child(3){border-color:var(--amber);background:#fffbeb;}
.office-r:nth-child(4){border-color:var(--rose);background:#fff1f2;}
.office-r strong{display:block;font-size:.72rem;font-weight:600;color:var(--muted);margin-bottom:.3rem;letter-spacing:.08em;text-transform:uppercase;}
.office-r span{font-size:.85rem;color:var(--ink);font-weight:400;}

/* FOOTER */
footer{padding:2rem 3rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;background:var(--ink);}
.footer-logo{font-family:'Fraunces',serif;font-weight:700;font-size:.95rem;color:#fff;display:flex;align-items:center;gap:.5rem;text-decoration:none;}
footer p{font-size:.75rem;color:rgba(255,255,255,0.35);}
.footer-links{display:flex;gap:2rem;list-style:none;}
.footer-links a{font-size:.75rem;color:rgba(255,255,255,0.4);text-decoration:none;transition:color .2s;}
.footer-links a:hover{color:var(--lime);}

/* REVEAL */
.reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease;}
.reveal.in{opacity:1;transform:none;}

/* RESPONSIVE */
@media(max-width:900px){
  nav{padding:1rem 1.5rem;}
  .nav-links{display:none;}
  .hero{grid-template-columns:1fr;padding:5rem 0 0;}
  .hero-img{display:none;}
  .hero-text{padding:3rem 1.5rem 2rem;}
  .hero-stats{grid-column:1;grid-template-columns:1fr 1fr;}
  .about-strip{grid-template-columns:1fr;}
  .about-img{height:260px;}
  .about-content{padding:3rem 1.5rem;}
  .services,.why,.testimonials,.coverage,.process{padding:4rem 1.5rem;}
  .impact{grid-template-columns:1fr;padding:4rem 1.5rem;gap:3rem;}
  .svc-grid{grid-template-columns:1fr 1fr;}
  .svc-card:nth-child(7){grid-column:span 2;}
  .section-head{flex-direction:column;}
  .section-note{text-align:left;}
  .gallery{grid-template-columns:1fr 1fr;grid-template-rows:200px 200px;}
  .gallery-item:nth-child(1){grid-row:span 1;}
  .gallery-item:nth-child(4),.gallery-item:nth-child(5){display:none;}
  .why-grid{grid-template-columns:1fr;}
  .process-steps{grid-template-columns:1fr 1fr;}
  .process-steps::before{display:none;}
  .testi-grid{grid-template-columns:1fr;}
  .contact{grid-template-columns:1fr;gap:2.5rem;padding:4rem 1.5rem;}
  .regions-grid{grid-template-columns:1fr 1fr;}
  footer{flex-direction:column;align-items:flex-start;padding:1.5rem;}
  .footer-links{flex-wrap:wrap;gap:1rem;}
}
</style>
</head>
